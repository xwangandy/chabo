# 插播生产环境模板
#
# 用法：
#   sudo install -o root -g chabo -m 0640 .env.production.example /etc/chabo/env
#   sudo editor /etc/chabo/env
#
# 注意：本文件只放占位值。生产密钥必须在 /etc/chabo/env 中替换为强随机值，
# 不要把真实 token 提交到 git。

# 部署域名，仅供部署脚本和运维命令使用
CHABO_ENV=production
CHABO_PUBLIC_HOST=chabo.example
CHABO_PUBLIC_BASE_URL=https://chabo.example

# 数据与平台账号
CHABO_DB_PATH=/var/lib/chabo/chabo.sqlite3
CHABO_PLATFORM_ACCOUNT_ID=platform

# Telegram Bot
CHABO_BOT_TOKEN=123456:replace_with_real_bot_token
CHABO_BOT_USERNAME=ChaBoBot
CHABO_TELEGRAM_HTTP_BACKEND=auto
CHABO_BOT_AUTO_APPROVE_ORDERS=0

# 旧 webhook / stdlib admin 仍使用的强密钥
CHABO_WEB_HOST=127.0.0.1
CHABO_WEB_PORT=8080
CHABO_ADMIN_TOKEN=replace_with_32_bytes_random_token
CHABO_WEBHOOK_SECRET=replace_with_32_bytes_random_secret

# React 网页端 FastAPI
CHABO_API_HOST=127.0.0.1
CHABO_API_PORT=8081
CHABO_API_SECRET_KEY=replace_with_32_bytes_random_secret
CHABO_SESSION_COOKIE_NAME=chabo_session
CHABO_SESSION_COOKIE_SECURE=1
CHABO_SESSION_COOKIE_SAMESITE=lax
CHABO_WEB_ALLOWED_ORIGINS=https://chabo.example
CHABO_API_PROXY_HEADERS=1
CHABO_API_FORWARDED_ALLOW_IPS=127.0.0.1

# 生产必须保持关闭
CHABO_DEV_SESSION_ENABLED=0
CHABO_DEV_AUTH_BYPASS=0

# 登录有效期
CHABO_MAGIC_LINK_TTL_SECONDS=600
CHABO_IMPERSONATION_SESSION_TTL_SECONDS=3600
CHABO_TELEGRAM_WEBAPP_MAX_AGE_SECONDS=3600

# 审计保留与导出上限
CHABO_AUDIT_RETENTION_DAYS=1095
CHABO_AUDIT_EXPORT_MAX_ROWS=5000

# 默认业务参数
CHABO_DEFAULT_SERVICE_FEE_BPS=500
CHABO_DEFAULT_HOLDBACK_BPS=1000
CHABO_DEFAULT_HOLDBACK_DAYS=7
CHABO_STAR_CREDIT_CENTS=1
