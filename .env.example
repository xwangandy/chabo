# 插播 Bot 配置
CHABO_ENV=local
CHABO_DB_PATH=./chabo.sqlite3
CHABO_BOT_TOKEN=123456:replace_me
CHABO_BOT_USERNAME=ChaBoBot
CHABO_PLATFORM_ACCOUNT_ID=platform

# 默认业务参数
CHABO_DEFAULT_SERVICE_FEE_BPS=500
CHABO_DEFAULT_HOLDBACK_BPS=1000
CHABO_DEFAULT_HOLDBACK_DAYS=7
CHABO_STAR_CREDIT_CENTS=1
CHABO_TELEGRAM_HTTP_BACKEND=auto

# HTTP webhook 与运营后台
CHABO_WEB_HOST=127.0.0.1
CHABO_WEB_PORT=8080
CHABO_ADMIN_TOKEN=replace_admin_token
CHABO_WEBHOOK_SECRET=replace_webhook_secret

# React 网页端 API
CHABO_API_HOST=127.0.0.1
CHABO_API_PORT=8081
CHABO_PUBLIC_BASE_URL=http://127.0.0.1:5173
CHABO_API_SECRET_KEY=replace_api_secret
CHABO_SESSION_COOKIE_NAME=chabo_session
CHABO_SESSION_COOKIE_SECURE=0
CHABO_SESSION_COOKIE_SAMESITE=lax
CHABO_WEB_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CHABO_API_PROXY_HEADERS=0
CHABO_API_FORWARDED_ALLOW_IPS=127.0.0.1
# 仅限本地开发：允许 /login/admin 使用管理 token 创建临时开发会话，生产必须保持 0
CHABO_DEV_SESSION_ENABLED=1
# 仅限本地开发：免登录进入三端门户，生产必须保持 0
CHABO_DEV_AUTH_BYPASS=0
CHABO_DEV_AUTH_TELEGRAM_USER_ID=10001
CHABO_DEV_AUTH_DISPLAY_NAME=开发者
CHABO_MAGIC_LINK_TTL_SECONDS=600
CHABO_IMPERSONATION_SESSION_TTL_SECONDS=3600
CHABO_TELEGRAM_WEBAPP_MAX_AGE_SECONDS=3600
CHABO_AUDIT_RETENTION_DAYS=1095
CHABO_AUDIT_EXPORT_MAX_ROWS=5000
